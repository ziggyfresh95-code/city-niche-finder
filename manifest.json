{
  "manifest_version": 3,
  "name": "City Niche Finder",
  "version": "1.4.0",
  "description": "Score local niche/city competition off Google's Map Pack + organic results, save leads, rate niches, and export to CSV.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.google.com/*", "https://www.google.co.uk/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "City Niche Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*", "https://www.google.co.uk/search*"],
      "js": ["src/niches.js", "src/scoring.js", "src/storage.js", "src/parser.js", "src/cities.js", "src/turbo.js", "src/uule.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
